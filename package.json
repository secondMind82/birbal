{
  "name": "birbal-rn",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/drawer": "^7.13.9",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "axios": "^1.19.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify:backup": "rm -rf .verify-build && tsc -p tsconfig.scripts.json && BIRBAL_ROOT=\"$PWD\" node --test .verify-build/birbal/scripts/verify-backup.js",
    "verify:backup:build": "tsc -p tsconfig.scripts.json",
    "verify:backup:live": "tsc -p tsconfig.scripts.json && BIRBAL_ROOT=\"$PWD\" node .verify-build/birbal/scripts/verify-backup-live.js",
    "verify:sms": "tsc -p tsconfig.scripts.json && BIRBAL_ROOT=\"$PWD\" node --test .verify-build/birbal/scripts/verify-sms.js",
    "verify:bell": "tsc -p tsconfig.scripts.json && BIRBAL_ROOT=\"$PWD\" node --test .verify-build/birbal/scripts/verify-bell.js",
    "verify:sms:pipe": "tsc -p tsconfig.scripts.json && BIRBAL_ROOT=\"$PWD\" node --test .verify-build/birbal/scripts/verify-sms-pipeline.js",
    "verify:money": "tsc -p tsconfig.scripts.json && BIRBAL_ROOT=\"$PWD\" node --test .verify-build/birbal/scripts/verify-money.js .verify-build/birbal/scripts/verify-expense-flow.js .verify-build/birbal/scripts/verify-sms-permission.js .verify-build/birbal/scripts/verify-timeline-money.js",
    "verify": "npm run verify:sms && npm run verify:sms:pipe && npm run verify:bell && npm run verify:money && npm run verify:backup"
  },
  "private": true
}
