{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "..",
    "outDir": ".verify-build",
    "noEmit": false
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/stubs/**/*.ts",
    "modules/birbal-sms/index.ts",
    "src/db/backupTables.ts",
    "src/db/backupValidation.ts",
    "src/db/schema.ts",
    "src/db/database.ts",
    "src/db/repositories/backup.ts",
    "src/db/repositories/timelines.ts",
    "src/db/repositories/entities.ts",
    "src/db/repositories/smsMessages.ts",
    "src/services/timelinesService.ts",
    "src/services/expensesService.ts",
    "src/api/client.ts",
    "src/api/apiService.ts",
    "src/store/session.ts",
    "src/services/notificationScheduler.ts",
    "src/db/models/backupRows.ts",
    "src/services/backupCanonical.ts",
    "src/services/backupCounts.ts",
    "src/services/backupMigration.ts",
    "src/services/backupCanonical.ts",
    "src/models/types.ts",
    "../SecondBrain/secondbrain-api/src/backup/backup-format.ts",
    "src/utils/smsFilter.ts",
    "src/utils/entityLookup.ts",
    "src/utils/activityParser.ts",
    "src/utils/money.ts"
  ]
}